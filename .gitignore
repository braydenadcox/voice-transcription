.venv/
__pycache__/
*.py[cod]

# Generated transcripts are local output. Keep the directory via transcripts/.gitkeep.
transcripts/*
!transcripts/.gitkeep

# Saved meeting recordings are local output. Keep the directory via recordings/.gitkeep.
recordings/*
!recordings/.gitkeep

# The user's local meeting schedule and scheduler state.
schedule.json
schedule.json.tmp
